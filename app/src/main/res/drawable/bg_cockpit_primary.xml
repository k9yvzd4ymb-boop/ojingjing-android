<?xml version="1.0" encoding="utf-8"?>
<!-- 交互中枢主卡片：流金磨砂水晶质感 + 18dp 圆角 + 触控流光水波 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="315"
                        android:startColor="#F7E6C4"
                        android:centerColor="#DFBA6B"
                        android:endColor="#B38938"
                        android:type="linear" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#FFF8E7" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
