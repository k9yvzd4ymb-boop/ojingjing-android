<?xml version="1.0" encoding="utf-8"?>
<!-- 浮层弹窗玻璃卡：深曜石晶体板 + 细腻香槟金发丝边框，圆角 24dp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#F5141B25"
        android:endColor="#F50D121B"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#36DFBA6B" />
</shape>
