<?xml version="1.0" encoding="utf-8"?>
<!-- 交互中枢次级卡片：冷曜半透晶石底 + 18dp 圆角 + 香槟金边 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#25DFBA6B">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#B31A2433"
                android:endColor="#D9101621"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#36DFBA6B" />
        </shape>
    </item>
</ripple>
