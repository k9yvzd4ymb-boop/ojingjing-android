<?xml version="1.0" encoding="utf-8"?>
<!-- 连接记录：深曜石半透晶体卡片 + 0.75dp 香槟金微光轮廓 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20DFBA6B">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#CC18222F"
                android:endColor="#D9101621"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#2EDFBA6B" />
        </shape>
    </item>
</ripple>
