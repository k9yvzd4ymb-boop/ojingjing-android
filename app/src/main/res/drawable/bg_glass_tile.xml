<?xml version="1.0" encoding="utf-8"?>
<!-- 设备网格卡片：晶曜毛玻璃底座 + 1.2dp 香槟金光泽发丝微边 + 触控流金光晕 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33DFBA6B">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B31A2636"
                        android:centerColor="#C7121A26"
                        android:endColor="#D90C121A"
                        android:type="linear" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#38DFBA6B" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
